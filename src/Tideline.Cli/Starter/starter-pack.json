    { "name": "Starter: software, AI and websites", "priority": 1350,
      "when": { "contains_any": ["MICROSOFT", "MSBILL", "ADOBE", "DROPBOX", "GOOGLE ONE", "GOOGLE STORAGE", "OPENAI", "CHATGPT", "ANTHROPIC", "CLAUDE.AI", "GITHUB", "1PASSWORD", "LASTPASS", "DASHLANE", "NORDVPN", "EXPRESSVPN", "QUICKEN INC", "NAMECHEAP", "NAME-CHEAP", "GODADDY", "INMOTION", "DIRECTNIC", "SQUARESPACE", "WIX.COM", "CANVA.COM", "RING.COM", "AURA.COM", "ZOOM.US", "EVERNOTE", "GRAMMARLY", "PATREON", "SUBSTACK", "NYTIMES", "NY TIMES", "WASHINGTONPOST", "DUOLINGO", "MASTERCLASS"] },
