{
  // Starter categories and rules for a US household that banks with Truist. Same format as a household file, but only categories and rules.
  // Load it with: tideline starter. It only adds what is missing (by name), so it is safe to run again.
  //
  // Only national brands and plain bank wording are matched here: nothing about any one household. Rules sit at 1000 and up, so any rule
  // you make yourself (lower numbers) is tried first and wins. Anything no rule matches goes to Uncategorized with the review tag.
  // Words are matched anywhere in the description, ignoring case. Keep them long enough not to match by accident (for example "SHELL OIL",
  // never "SHELL", which is also part of a mortgage servicer's name).
  "categories": [
    { "name": "Salary", "defaultType": "income" },
    { "name": "Pension and benefits", "defaultType": "income" },
    { "name": "Tax refund", "defaultType": "income" },
    { "name": "Interest and dividends", "defaultType": "income" },
    { "name": "Other income", "defaultType": "income" },

    { "name": "Mortgage", "defaultType": "bill" },
    { "name": "Rent", "defaultType": "bill" },
    { "name": "HOA dues", "defaultType": "bill" },
    { "name": "Property tax", "defaultType": "bill" },
    { "name": "Utilities", "defaultType": "bill" },
    { "name": "Internet and phone", "defaultType": "bill" },
    { "name": "Insurance", "defaultType": "bill" },
    { "name": "Student loans", "defaultType": "bill" },
    { "name": "Loan payments", "defaultType": "bill" },

    { "name": "Groceries", "defaultType": "required" },
    { "name": "Gas and fuel", "defaultType": "required" },
    { "name": "Auto upkeep", "defaultType": "required" },
    { "name": "Parking and tolls", "defaultType": "required" },
    { "name": "Medical", "defaultType": "required" },
    { "name": "Pets", "defaultType": "required" },
    { "name": "Childcare", "defaultType": "required" },
    { "name": "Kids and school", "defaultType": "required" },
    { "name": "Home upkeep", "defaultType": "required" },

    { "name": "Dining", "defaultType": "extra" },
    { "name": "Coffee", "defaultType": "extra" },
    { "name": "Delivery", "defaultType": "extra" },
    { "name": "Alcohol", "defaultType": "extra" },
    { "name": "Shopping", "defaultType": "extra" },
    { "name": "Clothing", "defaultType": "extra" },
    { "name": "Home improvement", "defaultType": "extra" },
    { "name": "Entertainment", "defaultType": "extra" },
    { "name": "Subscriptions", "defaultType": "extra" },
    { "name": "Fitness", "defaultType": "extra" },
    { "name": "Personal care", "defaultType": "extra" },
    { "name": "Rideshare and taxi", "defaultType": "extra" },
    { "name": "Giving", "defaultType": "extra" },
    { "name": "Fees and interest", "defaultType": "extra" },
    { "name": "Cash", "defaultType": "extra" },

    { "name": "Travel", "defaultType": "one_time" },
    { "name": "Home repairs", "defaultType": "one_time" },
    { "name": "Taxes", "defaultType": "one_time" },

    { "name": "Investments", "defaultType": "savings" }
  ],
  "rules": [
    // ---- money in
    { "name": "Starter: paycheck", "priority": 1000,
      "when": { "direction": "in", "account_kind": ["checking", "savings"], "contains_any": ["PAYROLL", "DIRECT DEP", "DIR DEP", "SALARY"] },
      "set": { "category": "Salary" } },
    { "name": "Starter: pension and benefits", "priority": 1010,
      "when": { "direction": "in", "contains_any": ["SOCIAL SECURITY", "SSA TREAS", "PENSION", "RETIREMENT BENEFIT", "UNEMPLOYMENT"] },
      "set": { "category": "Pension and benefits" } },
    { "name": "Starter: tax refund", "priority": 1020,
      "when": { "direction": "in", "contains_any": ["IRS TREAS", "TAX REFUND", "TAX REF", "TAXRFD", "TAX RFD", "DEPT TAXATION", "DEPT OF TAXATION", "DEPT OF REVENUE", "DEPT REVENUE"] },
      "set": { "category": "Tax refund" } },
    { "name": "Starter: interest and dividends", "priority": 1030,
      "when": { "direction": "in", "account_kind": ["checking", "savings"], "contains_any": ["INTEREST", "DIVIDEND"] },
      "set": { "category": "Interest and dividends" } },

    // ---- fees and taxes (before the shops, so a fee at a shop is still a fee)
    { "name": "Starter: interest and fees", "priority": 1100,
      "when": { "contains_any": ["INTEREST CHARGE", "FINANCE CHRG", "FINANCE CHARGE", "LATE PAYMENT FEE", "LATE FEE", "ANNUAL FEE", "OVERDRAFT", "NSF FEE", "NSF ITEM", "SERVICE CHARGE", "MAINTENANCE FEE", "WIRE FEE", "ATM SURCHARGE", "ATM FEE", "SERVICE ASSESSMENT", "FOREIGN TRANSACTION", "FOREIGN TRANS FEE"] },
      "set": { "category": "Fees and interest" } },
    { "name": "Starter: property tax", "priority": 1110,
      "when": { "contains_any": ["PROPERTY TAX", "TAX COLLECTOR", "COUNTY TAX", "TREASURER", "PERSONAL PROPERTY"] },
      "set": { "category": "Property tax" } },
    { "name": "Starter: income tax and tax help", "priority": 1120,
      "when": { "contains_any": ["USATAXPYMT", "IRS PAYMENT", "IRS USATAX", "IRS TREAS", "STATE TAX", "TAX PAYMENT", "DEPT TAXATION", "DEPT OF TAXATION", "DEPT OF REVENUE", "FRANCHISE TAX", "TURBOTAX", "H&R BLOCK", "TAXACT", "JACKSON HEWITT"] },
      "set": { "category": "Taxes" } },

    // ---- housing and loans
    { "name": "Starter: mortgage", "priority": 1200,
      "when": { "contains_any": ["MORTGAGE", "MTG PMT", "MTGE", "NEWREZ", "SHELLPOIN", "NATIONSTAR", "MR COOPER", "MR. COOPER", "PENNYMAC", "FREEDOM MTG", "QUICKEN LOANS", "LOANDEPOT", "CARRINGTON"] },
      "set": { "category": "Mortgage" } },
    { "name": "Starter: rent", "priority": 1210,
      "when": { "contains_any": ["RENT PAYMENT", "RENT PMT", "RENTCAFE", "APPFOLIO", "PAYLEASE", "PROPERTY MGMT", "PROPERTY MANAGEMENT"] },
      "set": { "category": "Rent" } },
    { "name": "Starter: HOA", "priority": 1220,
      "when": { "contains_any": ["HOA DUES", "HOA PMT", "HOA PAYMENT", "HOMEOWNERS ASSOC", "HOMEOWNER ASSOC", "HOMEOWNERS ASSN", "COMMUNITY ASSOC"] },
      "set": { "category": "HOA dues" } },
    { "name": "Starter: student loans", "priority": 1230,
      "when": { "contains_any": ["NELNET", "NAVIENT", "FIRSTMARK", "MOHELA", "AIDVANTAGE", "SALLIE MAE", "EDFINANCIAL", "STUDENT LOAN", "STDNT LOAN", "STUDENT LN", "DEPT OF EDUCATION", "DEPT OF ED "] },
      "set": { "category": "Student loans" } },
    { "name": "Starter: car and personal loans", "priority": 1240,
      "when": { "contains_any": ["AUTO LOAN", "AUTO FINANCE", "AUTO PMT", "TOYOTA FINANCIAL", "TOYOTA MOTOR CREDIT", "HONDA FINANCIAL", "FORD CREDIT", "GM FINANCIAL", "NISSAN MOTOR ACC", "HYUNDAI MOTOR FIN", "AMERICREDIT", "CARMAX AUTO", "CAPITAL ONE AUTO", "LOAN PAYMENT", "LOAN PMT", "LENDINGCLUB", "LENDING CLUB"] },
      "set": { "category": "Loan payments" } },

    // ---- bills
    { "name": "Starter: electric and gas", "priority": 1300,
      "when": { "contains_any": ["ELECTRIC CO", "ELECTRIC COOP", "ELECTRIC UTIL", "ELEC CO", "POWER & LIGHT", "POWER AND LIGHT", "DOMINION ENERGY", "DUKE ENERGY", "XCEL ENERGY", "ENTERGY", "CON EDISON", "CONED", "PG&E", "PACIFIC GAS", "SOUTHERN CALIF EDISON", "AMEREN", "EVERSOURCE", "NATIONAL GRID", "CONSUMERS ENERGY", "DTE ENERGY", "GEORGIA POWER", "FIRSTENERGY", "CENTERPOINT", "ATMOS ENERGY", "SOUTHWEST GAS", "PSE&G", "PEPCO", "NATURAL GAS", "GAS COMPANY", "GAS CO ", "GAS SERVICE", "UTILITY", "UTILITIES"] },
