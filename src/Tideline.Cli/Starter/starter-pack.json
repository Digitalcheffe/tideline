      "set": { "category": "Fitness" } },

    // ---- a delivery app puts its own name first ("DOORDASH WAWA"), so it has to be tried before the shop it delivers from
    { "name": "Starter: delivery and takeout apps", "priority": 1490,
      "when": { "contains_any": ["DOORDASH", "UBER *EATS", "UBER EATS", "UBEREATS", "GRUBHUB", "POSTMATES", "SEAMLESS", "CHOWNOW"] },
