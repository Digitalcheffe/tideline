      "set": { "category": "Utilities" } },
    { "name": "Starter: trash and recycling", "priority": 1310,
      "when": { "contains_any": ["WASTE MANAGEMENT", "WM EZPAY", "REPUBLIC SERVICES", "GFL ENV", "GFL - ENV", "WASTE CONNECTIONS", "TRASH", "GARBAGE", "SANITATION", "RECYCL"] },
      "set": { "category": "Utilities" } },
    { "name": "Starter: internet, phone and TV", "priority": 1320,
      "when": { "contains_any": ["VERIZON", "AT&T", "ATT*", "T-MOBILE", "TMOBILE", "T MOBILE", "COMCAST", "XFINITY", "SPECTRUM", "CHARTER COMM", "COX COMM", "CENTURYLINK", "FRONTIER COMM", "ALTICE", "GOOGLE FI", "GOOGLE FIBER", "MINT MOBILE", "CRICKET WIRELESS", "METROPCS", "BOOST MOBILE", "STRAIGHT TALK", "US CELLULAR", "WINDSTREAM", "STARLINK", "HUGHESNET", "DIRECTV", "DISH NETWORK", "SLING TV"] },
      "set": { "category": "Internet and phone" } },
    { "name": "Starter: insurance", "priority": 1330,
      "when": { "contains_any": ["INSURANC", "INS PREMIUM", "INS PMT", "GEICO", "STATE FARM", "PROGRESSIVE INS", "ALLSTATE", "USAA", "NATIONWIDE", "LIBERTY MUTUAL", "FARMERS INS", "TRAVELERS INS", "ERIE INS", "LEMONADE", "BLUE CROSS", "BCBS", "ANTHEM", "AETNA", "CIGNA", "HUMANA", "UNITEDHEALTHCARE", "UNITED HEALTHCARE"] },
