      "set": { "category": "Pets" } },
    { "name": "Starter: medical", "priority": 1510,
      "when": { "contains_any": ["PHARMACY", "CVS/", "WALGREENS", "RITE AID", "HOSPITAL", "MEDICAL", "CLINIC", "URGENT CARE", "CARENOW", "DENTAL", "DENTIST", "ORTHO", "PEDIATRIC", "DERMATOLOG", "ALLERGY", "EAR NOSE", "OPTOMETR", "EYE CARE", "EYECARE", "LABCORP", "QUEST DIAG", "PHYSICIAN", "THERAPY", "COUNSELING", "PSYCHOLOG", "PHR*", "LENSCRAFTERS", "WARBY PARKER", "GOODRX"] },
