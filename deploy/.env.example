# Copy to deploy/.env (it is git-ignored) and fill in only what you use. Never commit a filled-in copy.
# Secrets come from your password manager. Webhook addresses, mail passwords and the SimpleFIN address are
# entered in the app (Settings, Notifications and Imports); they are stored sealed, not in this file.

# Turn the six-hourly bank sync on once SimpleFIN is set up in the app.
SimpleFin__Enabled=false

# Optional: a folder (or a mapped network share) on this computer to use as the CSV inbox, with forward slashes,
# for example C:/Users/you/Documents/tideline-inbox. Leave it out to use an empty Docker volume instead.
# TIDELINE_INBOX=
